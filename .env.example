DATABASE_URL=postgresql://fastlogistics:fastlogistics_local@127.0.0.1:15432/fastlogistics
# Generate a unique value with openssl rand -hex 32.
AUTH_CODE_SECRET=
# Enable only for local development. Codes appear in the local API process log.
AUTH_DEV_CODES=0
# Production SMS/email relay. HTTPS URL and relay credential are both required.
AUTH_DELIVERY_WEBHOOK=
AUTH_DELIVERY_TOKEN=
AUTH_API_URL=http://127.0.0.1:8080
# Website addresses allowed to send waitlist signups, comma-separated.
WAITLIST_ORIGINS=http://127.0.0.1:8092,http://localhost:8092

# Server-only Mapbox Directions credential.
MAPBOX_ACCESS_TOKEN=
REDIS_URL=redis://127.0.0.1:16379
# Set to 60 to enable a one-minute cache once provider terms permit retention.
ROUTE_CACHE_TTL_SECONDS=0

# Voice relay. Generate an independent secret with openssl rand -hex 32.
TURN_SHARED_SECRET=
# Comma-separated relay URLs advertised to clients.
TURN_URLS=
# Required only for the Linux development coturn overlay.
TURN_LISTEN_IP=

# Account archive encryption. Keep this key outside the database.
ACCOUNT_ARCHIVE_KEY=

# Bachs sandbox only. The payment API rejects live keys.
BACHS_SANDBOX_SECRET_KEY=
BACHS_SANDBOX_WEBHOOK_SECRET=

# Smile ID sandbox hosted rider checks.
SMILE_SANDBOX_PARTNER_ID=
SMILE_SANDBOX_API_KEY=
SMILE_CALLBACK_SECRET=
SMILE_CALLBACK_BASE_URL=
SMILE_PRIVACY_URL=
